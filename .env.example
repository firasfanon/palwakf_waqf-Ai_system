# =========================
# Local Sovereign Development Environment
# =========================

# Database
# Runtime currently uses Drizzle MySQL schema. Use ONE of the supported MySQL forms below.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/waqf_ai_model
# Optional alias if DATABASE_URL is reserved by another platform process:
MYSQL_DATABASE_URL=
# Optional decomposed form. Values are composed into mysql://user:password@host:port/database.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# PostgreSQL/Supabase URLs are intentionally detected but blocked by the current MySQL runtime.
# Do not place a Supabase PostgreSQL URL here unless a future PostgreSQL adapter is explicitly implemented.

# Session / Auth
JWT_SECRET=change-this-local-secret
LOCAL_AUTH_ENABLED=1
LOCAL_AUTH_OPEN_ID=local-admin
LOCAL_AUTH_NAME=Local Admin
LOCAL_AUTH_EMAIL=admin@local.test
# Must match a row in platform admin_users during platform identity mode
LOCAL_AUTH_ROLE=admin
LOCAL_AUTH_DEFAULT_REDIRECT=/

# Optional external OAuth (disabled by default for local sovereign development)
EXTERNAL_OAUTH_ENABLED=0
VITE_EXTERNAL_OAUTH_ENABLED=0
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=palwakf-local
OWNER_OPEN_ID=
OWNER_NAME=

# AI / service provider endpoints
# Local Ollama defaults:
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
#   OLLAMA_API_KEY=ollama
#   OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2

# Optional OpenAI-compatible overrides
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=

# Optional frontend map proxy
VITE_MAP_PROXY_URL=
VITE_MAP_PROXY_API_KEY=

# Legacy compatibility (optional only if still needed)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Local bootstrap hardening
PUBLISH_SCHEDULER_ENABLED=0
OWNER_NOTIFICATIONS_ENABLED=0

# App Configuration
VITE_APP_TITLE=منصة PalWakf للذكاء والمعرفة الوقفية
VITE_APP_LOGO=/logo.png
VITE_FORCE_HASH_ROUTING=1


# =========================
# Platform Bridge / PalWakf Unified DB (optional)
# =========================
# Platform identity mode (set to 1 when adopting users from PalWakf)
PLATFORM_BRIDGE_ENABLED=0
PLATFORM_BRIDGE_STRICT=0
PLATFORM_SUPABASE_URL=
PLATFORM_SUPABASE_PROJECT_REF=
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Source-of-truth objects (adjust to your PalWakf database)
PLATFORM_ADMIN_SCHEMA=public
PLATFORM_ADMIN_USERS_TABLE=admin_users
PLATFORM_CORE_SCHEMA=core
PLATFORM_ORG_UNITS_TABLE=org_units
PLATFORM_WAQF_SCHEMA=waqf
PLATFORM_WAQF_ASSETS_TABLE=waqf_assets
PLATFORM_ENDOWMENTS_TABLE=endowment_names
PLATFORM_KNOWLEDGE_SCHEMA=public
PLATFORM_REFERENCES_TABLE=land_references

# =========================
# Mega Batch 29A — Remote Staging Evidence (safe labels only)
# =========================
# These are server-side deployment labels; do not place secrets in them.
PALWAKF_DEPLOYMENT_ENV=staging
PALWAKF_DEPLOYMENT_REF=replace-with-commit-or-release-hash
PALWAKF_BASELINE_ID=v65_mega_batch_29a_remote_staging_rbac_rls_uat_preapply_2026_06_20
