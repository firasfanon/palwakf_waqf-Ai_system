INSERT INTO knowledge_documents (title, content, source, category, tags, isActive, createdAt, updatedAt) VALUES ('مجموع فتاوى ابن تيمية - كتاب الوقف', 'مجموع فتاوى شيخ الإسلام أحمد بن عبد الحليم بن تيمية (ت 728 هـ)، يحتوي على فتاوى متعلقة بالوقف من المذهب الحنبلي.

استبدال الوقف:
- يجوز استبدال الوقف بخير منه إذا كان ذلك أنفع للموقوف عليهم
- مثال: إذا وقف داراً أو حانوتاً أو بستاناً أو قرية يكون مغلها قليلاً، فيبدلها بما هو أكثر غلة

الوقف على جهة مباحة:
- الوقف على الأغنياء جائز
- الوقف على المدارس والمساجد من أفضل الأوقاف

