INSERT INTO knowledge_documents (title, content, source, category, tags, isActive, createdAt, updatedAt) VALUES ('قانون الأراضي العثماني 1858', 'قانون الأراضي العثماني الصادر عام 1858 (1274 هجري) هو القانون الأساسي الذي ينظم ملكية الأراضي في فلسطين. لا يزال ساري النفاذ في الضفة الغربية وغزة.

تقسيم الأراضي (المادة 1):
1. الأراضي المملوكة: المحلات الحاصل التصرف بها على وجه الملكية
2. الأراضي الأميرية: الأراضي التابعة لبيت المال
3. الأراضي الموقوفة: الأراضي الموقوفة وفقاً للشرع
4. الأراضي المتروكة: المخصصة لعموم الناس أو أهالي القرى
